{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "B1 Chord Viewer",
  "version": "0.1.5.1",
  "identifier": "com.aerialist.b1chordviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "B1 Chord Viewer",
        "width": 1100,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "PASTE_YOUR_PUBLIC_KEY_HERE",
      "endpoints": [
        "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyOEZCNjhGNjlDM0RCNUIKUldSYjI4TnBqN2FQd3JHQVN1ZmlGZzV0enp2bjk3ODY2YkRvSG82RXdzREU3aXRrZCtsaTBzcS8K"
      ]
    }
  }
}
